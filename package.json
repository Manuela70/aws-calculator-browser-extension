{
  "name": "aws-calculator-extension-dev",
  "version": "0.0.0",
  "private": true,
  "description": "Tooling de desarrollo (tests, lint, formato) de la extensión AWS Calculator. No participa en la carga unpacked.",
  "type": "module",
  "scripts": {
    "lint": "eslint aws-calculator-extension tests scripts",
    "format": "prettier --write \"aws-calculator-extension/**/*.{js,json,html,css}\" \"tests/**/*.js\" \"scripts/**/*.js\" \"*.config.js\" \".github/**/*.yml\" .prettierrc",
    "format:check": "prettier --check \"aws-calculator-extension/**/*.{js,json,html,css}\" \"tests/**/*.js\" \"scripts/**/*.js\" \"*.config.js\" \".github/**/*.yml\" .prettierrc",
    "test": "vitest run",
    "test:u1": "vitest run tests/u1",
    "test:u2": "vitest run tests/u2",
    "coverage": "vitest run --coverage",
    "check:bundle": "node scripts/check-bundle.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "vitest": "^5.1.1"
  }
}
