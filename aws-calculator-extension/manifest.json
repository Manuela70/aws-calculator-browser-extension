{
  "manifest_version": 3,
  "name": "AWS Calculator — Applying",
  "version": "3.0.0",
  "key": "",
  "description": "RPA: genera estimados en AWS Pricing Calculator desde un JSON, desde el panel lateral.",
  "minimum_chrome_version": "130",
  "permissions": ["tabs", "scripting", "sidePanel", "storage", "unlimitedStorage", "identity"],
  "host_permissions": ["https://calculator.aws/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "AWS Calculator — Applying",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://calculator.aws/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*", "lib/*/*"],
      "matches": ["https://calculator.aws/*"],
      "use_dynamic_url": false
    }
  ]
}
